# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# --- Аккаунт ассистента (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Единственный Telegram ID, которого слушает ассистент (узнать: @userinfobot)
OWNER_ID=
OWNER_NAME=Абу

# --- Claude API ---
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
# USD за 1M токенов. Значения на 2026-10-06 по прайсу Anthropic; перед запуском сверить.
PRICE_IN_FAST=0.10
PRICE_OUT_FAST=0.50
PRICE_IN_SMART=2.00
PRICE_OUT_SMART=10.00
DAILY_BUDGET_USD=1.00

# --- Мост с роботом ---
# BRIDGE_KEY генерирует install.bat; тот же ключ вписать в InpBridgeKey робота
BRIDGE_KEY=
# пусто = %APPDATA%\MetaQuotes\Terminal\Common\Files\MrCasino
BRIDGE_ROOT=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_AUTORESTART=true
# пусто = брать символ из статуса робота
SYMBOL=

# --- Время ---
TZ=Asia/Bishkek
QUIET_HOURS=00:00-08:00
MORNING_HM=09:30
REPORT_HM=23:05
EVENING_ZONES_HM=22:30
WEEKLY=Sat 10:00

# --- Голос ---
# false (по умолчанию): только текст, torch и whisper не нужны, звонков нет, тревога придёт сообщением.
# true: голосовые сообщения, озвучка ответов, звонки. Нужны requirements-voice.txt и ffmpeg.
VOICE_ENABLED=false
VOICE=ru-RU-DmitryNeural
VOICE_TRADES=false
# base подходит для сервера 4 ГБ вместе с MT5; small точнее, но тяжелее по памяти
STT_MODEL=base
STT_DEVICE=auto
# звонок по критичной тревоге работает только при VOICE_ENABLED=true
CALL_ON_CRITICAL=true
CALL_MAX_MIN=15

# Уровень сообщений робота: 0 - только сделки и тревоги, 1 - плюс анализ, 2 - всё
MSG_LEVEL=1
