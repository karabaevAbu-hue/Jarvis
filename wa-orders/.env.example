# Скопируйте этот файл в .env и заполните. В Блокноте при сохранении выберите «Тип: все файлы».

# Токен Telegram-бота от @BotFather
TG_TOKEN=

# Ваш Telegram ID (узнать у @userinfobot) — владелец, получает все уведомления
OWNER_ID=

# Telegram ID операторов через запятую (могут менять заказы, группы, запускать; настройки — нет)
OPERATOR_IDS=

# Из консоли GREEN-API (console.green-api.com → ваш инстанс)
GREEN_API_URL=https://xxxx.api.greenapi.com
GREEN_MEDIA_URL=https://xxxx.media.greenapi.com
GREEN_ID_INSTANCE=
GREEN_API_TOKEN=

# developer — бесплатный тариф (бот не даст включить больше 3 групп), business — платный
GREEN_TARIFF=developer

# Часовой пояс для тихих часов и отчётов
APP_TZ=Asia/Bishkek
